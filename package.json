{
  "name": "render-engine",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "dev:cf": "wrangler dev",
    "build": "tsc",
    "check:cf": "wrangler deploy --dry-run",
    "deploy:cf": "wrangler deploy",
    "start": "node dist/index.js",
    "test": "tsx --test tests/static-routes.test.mjs tests/http-routes.test.ts tests/expand-photo-frames.test.ts tests/hyperframes-frame-gate.test.ts tests/hyperframes-provider.test.ts tests/cloudflare-worker.test.ts",
    "test:render": "tsx src/test-render.ts",
    "smoke:r2": "bash scripts/smoke-r2-write.sh",
    "scan:hyperframes-video": "tsx scripts/scan-hyperframes-video.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Self-hosted image/video render engine for social media templates",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@aws-sdk/client-s3": "^3.988.0",
    "@cloudflare/containers": "^0.3.2",
    "@google/genai": "^1.48.0",
    "canvas": "^3.2.1",
    "express": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "hyperframes": "^0.4.4",
    "konva": "^10.2.3",
    "multer": "^2.1.1",
    "playwright": "^1.59.1",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.83.0"
  }
}
